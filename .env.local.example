# Authentication Configuration
# Generate a secure random string for production (e.g., using: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# AWS DynamoDB Configuration
# Table name should match the Terraform output (users-{environment})
DYNAMODB_TABLE_NAME=users-dev

# AWS Region where DynamoDB table is provisioned
AWS_REGION=us-east-1

# AWS Credentials (if not using IAM roles)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# LinkedIn OAuth 2.0 Configuration
# Create a LinkedIn App at https://www.linkedin.com/developers/apps
# Enable "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn" products
# Add your redirect URI under Auth > OAuth 2.0 settings
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# Agent service configuration (formerly the separate Python service's env)
# DynamoDB table names should match the Terraform outputs
DYNAMODB_STRATEGIES_TABLE_NAME=strategies-dev
DYNAMODB_COPIES_TABLE_NAME=copies-dev
DYNAMODB_SCHEDULED_POSTS_TABLE_NAME=scheduled-posts-dev
DYNAMODB_PUBLISH_LOG_TABLE_NAME=publish-log-dev
DYNAMODB_MEDIA_TABLE_NAME=post-media-dev
S3_MEDIA_BUCKET=zetca-post-media-dev-831981619011

# Available active models: claude-sonnet-4-6, claude-haiku-4-5-20251001-v1:0, claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6

# Set to true to use mock agents (no AWS/Bedrock required), false to use real Bedrock agents
USE_MOCK_AGENT=false
AGENT_TIMEOUT_SECONDS=60

# LinkedIn auto-publish background scanner
PUBLISHER_ENABLED=true
PUBLISHER_SCAN_INTERVAL_SECONDS=60
LINKEDIN_API_TIMEOUT_SECONDS=30
